# Root
.DS_Store
Thumbs.db

# OpenCode local runtime artifacts
.opencode/node_modules/
.opencode/.opencode/
.opencode/.tmp/

# Pi Agent local runtime artifacts
.pi/node_modules/
.pi/package-lock.json
.pi/state/
.pi-subagents/

# Tool outputs / caches
**/.cache/
**/coverage/
**/dist/
**/build/

# Project workspaces
Project/

# External reference repositories and snapshots
everything-claude-code/
superpowers/
gstack/
opencode origin/
notes/
template/

# Claude Code source snapshots (do not commit third-party proprietary code)
tools/

# GitNexus generated artifacts (regenerate via `npx gitnexus analyze`)
.claude/

# Environment files (keep .env.example tracked)
**/.env
**/.env.local
**/.env.*.local
!**/.env.example

# Pi MCP adapter config (contains inline secrets — pi-mcp-adapter reads it)
.mcp.json
